# Holistic Health — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ── Supabase (server-only) ───────────────────────────────────────────────
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=<from supabase start output>

# ── Oura ─────────────────────────────────────────────────────────────────
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:3000/api/oura/callback

# ── Anthropic ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Web app (apps/web only) ──────────────────────────────────────────────
# Public — safe to expose to the browser. Points at the apps/api host.
NEXT_PUBLIC_API_URL=http://localhost:3001
