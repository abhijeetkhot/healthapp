# Holistic Health — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ── Supabase (apps/api only) ──────────────────────────────────────────────
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=<from supabase start output>

# ── Oura (apps/api only) ──────────────────────────────────────────────────
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:3001/api/oura/callback

# ── Anthropic (apps/api only) ────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Auth / CORS (apps/api only) ──────────────────────────────────────────
# Shared secret — must match between web (cookie value) and api (header check)
AUTH_SECRET=<long random string>
# Used to sign cookies in Fastify
COOKIE_SECRET=<long random string>
# The Vercel URL of apps/web — used for CORS and Oura OAuth redirect
WEB_ORIGIN=http://localhost:3000

# ── Web app (apps/web only) ──────────────────────────────────────────────
# Public — safe to expose to the browser
NEXT_PUBLIC_API_URL=http://localhost:3001
